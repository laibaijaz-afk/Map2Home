# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# ── Database (Railway MySQL) ─────────────────────────────────────────────
# Copy these from your Railway MySQL service → Variables tab
DB_HOST=your-railway-mysql-host.railway.app
DB_USER=root
DB_PASSWORD=your-railway-mysql-password
DB_NAME=railway
DB_PORT=3306

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRY=7d

# ── CORS ─────────────────────────────────────────────────────────────────
# Your Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app

# ── Email (Nodemailer via Gmail App Password) ─────────────────────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=Map2Home <your-email@gmail.com>

# ── 3D Floor Plan API (optional external service) ────────────────────────
FLOORPLAN3D_API_URL=
FLOORPLAN3D_API_KEY=
FLOORPLAN3D_TIMEOUT_MS=20000
FLOORPLAN3D_RETRIES=2
FLOORPLAN3D_API_PATH=/generate-3d
